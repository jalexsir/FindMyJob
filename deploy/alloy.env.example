# Environment-файл для systemd-юніта alloy (аналог .env для бота).
# Копія з реальними значеннями НЕ комітиться (deploy/alloy.env — у .gitignore).
#
# Значення бери в Grafana Cloud: My Account -> обраний стек -> Loki ->
# "Send logs" (там і URL, і Username/instance ID, і кнопка створити API-токен).

LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
LOKI_USERNAME=your_loki_instance_id
LOKI_PASSWORD=your_grafana_cloud_api_token

# Ці три змінні читає штатний ExecStart офіційного пакета alloy
# (`alloy run $CUSTOM_ARGS --storage.path=... $CONFIG_FILE`) — без них
# сервіс падає одразу після старту ("Error: accepts 1 arg(s), received 0")
# і йде в нескінченний рестарт-цикл. При конфлікті dpkg під час
# встановлення (запитує, чи лишити наш /etc/default/alloy) обов'язково
# вибирай "N" (лишити свій) — і одразу додай ці рядки самостійно, пакет їх
# в існуючий файл не допише.
CONFIG_FILE="/etc/alloy/config.alloy"
CUSTOM_ARGS=""
RESTART_ON_UPGRADE=true

# Опційно — лише якщо розкоментував блок метрик сервера в alloy-config.alloy.
# Бери так само в Grafana Cloud, тільки розділ Prometheus ("Send metrics").
# PROMETHEUS_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
# PROMETHEUS_USERNAME=your_prometheus_instance_id
# PROMETHEUS_PASSWORD=your_grafana_cloud_api_token
